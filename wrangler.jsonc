{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "recoverymesh-labs",
  "main": "cloudflare/src/index.js",
  "compatibility_date": "2026-10-21",
  "upload_source_maps": true,
  "containers": [
    {
      "class_name": "RecoveryMeshContainer",
      "image": "./Dockerfile.cloudflare",
      "image_build_context": ".",
      "instance_type": "standard-1",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [{"name":"RECOVERYMESH","class_name":"RecoveryMeshContainer"}]
  },
  "exports": {
    "RecoveryMeshContainer": {"type":"durable-object","storage":"sqlite"}
  },
  "routes": [
    {"pattern":"recoverymesh.bharadnannuri.com","custom_domain":true}
  ],
  "observability": {"enabled":true}
}
